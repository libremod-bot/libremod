{
  "name": "libremod",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @libremod/db build && pnpm -r typecheck",
    "dev:bot": "pnpm --filter @libremod/bot dev",
    "deploy-commands": "pnpm --filter @libremod/bot deploy-commands",
    "db:generate": "pnpm --filter @libremod/db generate",
    "db:migrate": "pnpm --filter @libremod/db migrate",
    "test": "pnpm -r test"
  }
}
