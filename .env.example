# Discord Developer Portal -> deine Anwendung -> Bot -> Token
DISCORD_TOKEN=
# Discord Developer Portal -> deine Anwendung -> General Information -> Application ID
DISCORD_CLIENT_ID=
# Optional: Server-ID zum Testen. Gesetzt = Befehle sofort nur dort, leer = global (kann bis zu 1 Stunde dauern)
DISCORD_DEV_GUILD_ID=

# Dashboard: Discord Developer Portal -> OAuth2 -> Client Secret
DISCORD_CLIENT_SECRET=
# Öffentliche Adresse des Dashboards. Im Developer Portal unter OAuth2 -> Redirects
# muss <DASHBOARD_URL>/api/auth/callback eingetragen sein.
DASHBOARD_URL=https://dashboard.libremod.xyz
# Zufälliger Schlüssel für Login-Cookies, mindestens 32 Zeichen (z. B. openssl rand -hex 32)
SESSION_SECRET=
# Lokaler Port des Dashboards auf dem Server
DASHBOARD_PORT=3000

# Optional: Benachrichtigungen für Twitch-Livestreams. Kostenlose Anwendung anlegen unter
# https://dev.twitch.tv/console/apps (OAuth-Redirect beliebig, z. B. http://localhost), dann Client-ID und Secret eintragen.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Optional: Benachrichtigungen für Kick-Livestreams. Anwendung anlegen unter https://kick.com/settings/developer
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Datenbank (bei Docker Compose wird das automatisch gesetzt)
POSTGRES_USER=libremod
POSTGRES_PASSWORD=bitte-aendern
POSTGRES_DB=libremod
DATABASE_URL=postgres://libremod:bitte-aendern@localhost:5432/libremod

# trace | debug | info | warn | error
LOG_LEVEL=info
